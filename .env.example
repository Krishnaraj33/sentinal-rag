# ==============================================================================
# SentinelRAG: Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or container secrets.
# ==============================================================================

# --- PostgreSQL Relational Database ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel_db
# For Celery / sync db queries if needed:
DATABASE_SYNC_URL=postgresql+psycopg2://sentinel:sentinel_secret@localhost:5432/sentinel_db

# --- Redis Message Broker & Invalidation Queue ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant Vector Search Engine ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=sentinel_knowledge_base

# --- Security & JWT Identity Claims ---
JWT_SECRET_KEY=enterprise_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEBHOOK_SECRET=enterprise_webhook_secret_2026

# --- Embeddings & Cross-Encoder Re-Ranking ---
# Providers: sentence_transformers | fastembed | openai | mock
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
HF_HOME=./models

# --- LLM Grounded Generation ---
# Free-tier / OpenRouter / OpenAI-compatible / Groq
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Interactive Showcase UI & Gateway ---
API_GATEWAY_URL=http://localhost:8000
UI_PORT=8501
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO